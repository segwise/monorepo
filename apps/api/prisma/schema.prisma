generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid(7)) @db.Uuid

  name  String
  image String?

  email         String
  emailVerified Boolean? @map("email_verified")

  sessions Session[]
  accounts Account[]

  role String

  banned     Boolean?
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires") @db.Date

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([id])
  @@unique([email])
  @@index([email])
  @@map("users")
}

model Session {
  id String @id @default(uuid(7)) @db.Uuid

  token String

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String? @map("impersonated_by")

  expiresAt DateTime @map("expires_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([id])
  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id String @id @default(uuid(7)) @db.Uuid

  scope    String?
  password String?

  idToken      String? @map("id_token")
  accessToken  String? @map("access_token")
  refreshToken String? @map("refresh_token")

  accountId  String @map("account_id")
  providerId String @map("provider_id")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique(id)
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id String @id @default(uuid(7)) @db.Uuid

  identifier String
  value      String

  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([id])
  @@index([identifier])
  @@map("verifications")
}

model Quote {
  id String @id @default(uuid(7)) @db.Uuid

  type    TypeInsurance
  renewal Boolean

  temporaryInsuredId String           @map("insured_id") @db.Uuid
  temporaryInsured   TemporaryInsured @relation(fields: [temporaryInsuredId], references: [id], onDelete: Cascade)

  temporaryVehicleId String?           @map("temporary_vehicle_id") @db.Uuid
  temporaryVehicle   TemporaryVehicle? @relation(fields: [temporaryVehicleId], references: [id], onDelete: Cascade)

  status        StatusQuote @default(waiting)
  statusAt      DateTime    @default(now()) @map("status_at") @db.Timestamptz
  statusMessage String?     @map("status_message")

  requestAt DateTime @map("request_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([id])
  @@index([type])
  @@index([type, status])
  @@index([type, renewal])
  @@index([type, renewal, status])
  @@map("quotes")
}

model TemporaryInsured {
  id String @id @default(uuid(7)) @db.Uuid

  cpf               String        @db.VarChar(11)
  name              String
  birth             DateTime      @db.Date
  age               Int
  phone             String        @db.VarChar(13)
  maritalStatus     MaritalStatus @map("marital_status")
  qualificationTime Int           @map("qualification_time")
  profession        String?

  quotes Quote[]

  temporaryVehicles TemporaryVehicle[] @relation(map: "temporary_vehicle")

  @@unique([id])
  @@map("temporary_insureds")
}

model TemporaryVehicle {
  id String @id @default(uuid(7)) @db.Uuid

  temporaryInsuredId String           @map("insured_id") @db.Uuid
  temporaryInsured   TemporaryInsured @relation(fields: [temporaryInsuredId], references: [id], onDelete: Cascade)

  plate String? @db.VarChar(7)

  manufacturer String

  model     String
  modelYear Int    @map("model_year")

  chassi String?

  usage    VehicleUsage
  exchange VehicleExchange

  overnightPostalCode String @map("overnight_postal_code") @db.VarChar(8)

  residesIn            Residence @map("resides_in")
  garageOfTheResidence Garage    @map("garage_of_the_residence")

  garageAtWork   GarageWork   @map("garage_at_work")
  garageAtSchool GarageSchool @map("garage_at_school")

  armored              Boolean
  gasKit               Boolean @map("gas_kit")
  theInsuredIsTheOwner Boolean @map("the_insured_is_the_owner")
  funded               Boolean
  driversUnder26       Boolean @map("drivers_under_26")

  driverCPF   String   @map("driver_cpf") @db.VarChar(11)
  driverName  String   @map("driver_name")
  driverBirth DateTime @map("driver_birth") @db.Date
  driverAge   Int      @map("driver_age")
  driverPhone String   @map("driver_phone") @db.VarChar(13)

  quotes Quote[]

  @@unique([plate, temporaryInsuredId])
  @@map("temporary_vehicles")
}

model Manufacturer {
  id String @id @default(uuid(7)) @db.Uuid

  name  String
  image String
  icon  String

  @@unique([id])
  @@index([name])
  @@map("manufacturers")
}

enum Role {
  owner
  admin
  user
  broker
  producer
  finance
  counter
}

enum TypeInsurance {
  car
}

enum StatusQuote {
  waiting
  quoting
  quoted
  sent
  recused
  confirmed
}

enum MaritalStatus {
  single
  married
  divorced
  widowed
  separated
  common_law_marriage
}

enum VehicleUsage {
  leisure_and_work
  leisure
  client_supplier_visits
  app_based_transport
  taxi
  public_transportation
  delivieries
  tourism
}

enum VehicleExchange {
  manual
  automatic
}

enum Residence {
  home
  apartment
  house_condominium
  others
}

enum Garage {
  automatic_gate
  manual_gate
  private
  no_garage
}

enum GarageWork {
  yes
  no
  does_not_work
  does_not_use
}

enum GarageSchool {
  yes
  no
  does_not_study
  does_not_use
}
