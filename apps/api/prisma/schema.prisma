generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  runtime                = "bun"
  importFileExtension    = "ts"
  generatedFileExtension = "ts"
  moduleFormat           = "esm"
  previewFeatures        = ["relationJoins", "nativeDistinct", "fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid(7)) @db.Uuid

  name  String
  image String?

  email         String
  emailVerified Boolean? @map("email_verified")

  phone String? @db.VarChar(13)

  referral String

  role String

  banned     Boolean?
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires") @db.Date

  sessions Session[] @relation("session_to_user")
  accounts Account[] @relation("account_to_user")

  quotes Quote[] @relation("producer_quotes")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([referral])
  @@unique([email])
  @@index([name])
  @@index([email])
  @@index([phone])
  @@map("users")
}

model Session {
  id String @id @default(uuid(7)) @db.Uuid

  token String

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  userId String @map("user_id") @db.Uuid
  user   User   @relation("session_to_user", fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String? @map("impersonated_by")

  expiresAt DateTime @map("expires_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([token])
  @@map("sessions")
}

model Account {
  id String @id @default(uuid(7)) @db.Uuid

  scope    String?
  password String?

  idToken      String? @map("id_token")
  accessToken  String? @map("access_token")
  refreshToken String? @map("refresh_token")

  accountId  String @map("account_id")
  providerId String @map("provider_id")

  userId String @map("user_id") @db.Uuid
  user   User   @relation("account_to_user", fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique(id)
  @@map("accounts")
}

model Verification {
  id String @id @default(uuid(7)) @db.Uuid

  identifier String
  value      String

  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("verifications")
}

model TemporaryInsured {
  id String @id @default(uuid(7)) @db.Uuid

  name  String
  phone String @db.VarChar(13)

  cpf               String?        @db.VarChar(11)
  birth             DateTime?      @db.Date
  age               Int?
  maritalStatus     MaritalStatus? @map("marital_status")
  qualificationTime Int?           @map("qualification_time")
  profession        String?

  quotes Quote[] @relation("quote_to_temporary_insured")
  safes  Safe[]  @relation("safe_to_temporary_insured")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("temporary_insureds")
}

model Insured {
  id String @id @default(uuid(7)) @db.Uuid

  name  String
  phone String @db.VarChar(13)

  cpf           String        @db.VarChar(11)
  birth         DateTime      @db.Date
  age           Int
  maritalStatus MaritalStatus @map("marital_status")

  qualificationTime Int?    @map("qualification_time")
  profession        String?

  quotes Quote[] @relation("insured_to_quote")
  safes  Safe[]  @relation("insured_to_safe")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("insureds")
}

model Quote {
  id String @id @default(uuid(7)) @db.Uuid

  temporaryInsuredId String?           @map("temporary_insured_id") @db.Uuid
  temporaryInsured   TemporaryInsured? @relation("quote_to_temporary_insured", fields: [temporaryInsuredId], references: [id], onDelete: Restrict, map: "temporary_insured")

  insuredId String?  @map("insured_id") @db.Uuid
  insured   Insured? @relation("insured_to_quote", fields: [insuredId], references: [id], onDelete: Restrict)

  modality ModalityInsurance

  renewal     Boolean?
  association Boolean?

  insuranceCompanyId String?           @map("insurance_company_id") @db.Uuid
  insuranceCompany   InsuranceCompany? @relation("insurance_company_to_quote", fields: [insuranceCompanyId], references: [id], onDelete: Restrict, map: "insurance_company")

  expiration DateTime? @db.Date
  franchise  Decimal?  @db.Decimal(10, 2)

  quoteVehicle QuoteVehicle? @relation("quote_to_quote_vehicle", map: "quote_vehicle")

  producerId String? @map("producer_id") @db.Uuid
  producer   User?   @relation("producer_quotes", fields: [producerId], references: [id], onDelete: Restrict)

  status        StatusQuote @default(waiting)
  statusAt      DateTime    @default(now()) @map("status_at") @db.Timestamptz
  statusMessage String?     @map("status_message")

  requestAt DateTime @default(now()) @map("request_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([requestAt])
  @@index([producerId])
  @@index([insuranceCompanyId])
  @@index([status])
  @@index([modality])
  @@index([id, requestAt])
  @@map("quotes")
}

model Safe {
  id String @id @default(uuid(7)) @db.Uuid

  temporaryInsuredId String?           @map("temporary_insured_id") @db.Uuid
  temporaryInsured   TemporaryInsured? @relation("safe_to_temporary_insured", fields: [temporaryInsuredId], references: [id], onDelete: Restrict, map: "temporary_insured")

  insuredId String?  @map("insured_id") @db.Uuid
  insured   Insured? @relation("insured_to_safe", fields: [insuredId], references: [id], onDelete: Restrict)

  modality ModalityInsurance

  insuranceCompanyId String?           @map("insurance_company_id") @db.Uuid
  insuranceCompany   InsuranceCompany? @relation("insurance_company_to_safe", fields: [insuranceCompanyId], references: [id], onDelete: Restrict, map: "insurance_company")

  isExternal Boolean? @map("is_external")

  expiration DateTime @db.Date
  franchise  Decimal? @db.Decimal(10, 2)

  safeVehicle SafeVehicle? @relation("safe_to_safe_vehicle", map: "safe_vehicle")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("safes")
}

model QuoteVehicle {
  id String @id @default(uuid(7)) @db.Uuid

  quoteId String @map("quote_id") @db.Uuid
  quote   Quote  @relation("quote_to_quote_vehicle", fields: [quoteId], references: [id], onDelete: Cascade)

  vehicleId String?  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle? @relation("quote_vehicle_to_vehicle", fields: [vehicleId], references: [id], onDelete: Restrict)

  vehicleWithoutPlateId String?              @map("vehicle_without_plate_id") @db.Uuid
  vehicleWithoutPlate   VehicleWithoutPlate? @relation("quote_vehicle_to_vehicle_without_plate", fields: [vehicleWithoutPlateId], references: [id], map: "vehicle_without_plate", onDelete: Restrict)

  usage VehicleUsage

  overnightPostalCode String @map("overnight_postal_code") @db.VarChar(8)

  residesIn            Residence? @map("resides_in")
  garageOfTheResidence Garage?    @map("garage_of_the_residence")

  garageAtWork   GarageWork?   @map("garage_at_work")
  garageAtSchool GarageSchool? @map("garage_at_school")

  armored              Boolean?
  gasKit               Boolean? @map("gas_kit")
  theInsuredIsTheOwner Boolean? @map("the_insured_is_the_owner")
  funded               Boolean?
  driversUnder26       Boolean? @map("drivers_under_26")

  driverCPF   String?   @map("driver_cpf") @db.VarChar(11)
  driverName  String?   @map("driver_name")
  driverBirth DateTime? @map("driver_birth") @db.Date
  driverAge   Int?      @map("driver_age")
  driverPhone String?   @map("driver_phone") @db.VarChar(13)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([vehicleWithoutPlateId])
  @@unique([quoteId])
  @@map("quote_vehicles")
}

model SafeVehicle {
  id String @id @default(uuid(7)) @db.Uuid

  safeId String @map("safe_id") @db.Uuid
  safe   Safe   @relation("safe_to_safe_vehicle", fields: [safeId], references: [id], onDelete: Cascade)

  vehicleId String?  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle? @relation("safe_vehicle_to_vehicle", fields: [vehicleId], references: [id], onDelete: Restrict)

  vehicleWithoutPlateId String?              @map("vehicle_without_plate_id") @db.Uuid
  vehicleWithoutPlate   VehicleWithoutPlate? @relation("safe_vehicle_to_vehicle_without_plate", fields: [vehicleWithoutPlateId], references: [id], map: "vehicle_without_plate", onDelete: Restrict)

  usage VehicleUsage

  overnightPostalCode String @map("overnight_postal_code") @db.VarChar(8)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([vehicleWithoutPlateId])
  @@unique([safeId])
  @@map("safe_vehicles")
}

model Vehicle {
  id String @id @default(uuid(7)) @db.Uuid

  plate            String @db.VarChar(7)
  plateAlternative String @map("plate_alternative") @db.VarChar(7)

  manufacturerId String              @map("manufacturer_id") @db.Uuid
  manufacturer   ManufacturerVehicle @relation("manufacturer_vehicle_to_vehicle", fields: [manufacturerId], references: [id], onDelete: Restrict)

  model     String
  modelYear Int    @map("model_year")

  exchange VehicleExchange?

  chassi String?

  image String?

  quoteVehicles QuoteVehicle[] @relation("quote_vehicle_to_vehicle", map: "quote_vehicles")
  safeVehicles  SafeVehicle[]  @relation("safe_vehicle_to_vehicle", map: "safe_vehicles")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([plate])
  @@unique([plateAlternative])
  @@unique([plate, plateAlternative])
  @@map("vehicles")
}

model VehicleWithoutPlate {
  id String @id @default(uuid(7)) @db.Uuid

  manufacturerId String?              @map("manufacturer_id") @db.Uuid
  manufacturer   ManufacturerVehicle? @relation("manufacturer_vehicle_to_vehicle_without_plate", fields: [manufacturerId], references: [id], onDelete: Restrict)

  model     String?
  modelYear Int?    @map("model_year")

  exchange VehicleExchange?

  quoteVehicles QuoteVehicle[] @relation("quote_vehicle_to_vehicle_without_plate", map: "quote_vehicles")
  safeVehicles  SafeVehicle[]  @relation("safe_vehicle_to_vehicle_without_plate", map: "safe_vehicles")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("vehicles_without_plate")
}

model ManufacturerVehicle {
  id String @id @default(uuid(7)) @db.Uuid

  name  String
  icon  String?
  image String?

  slugs String[]

  vehicles              Vehicle[]             @relation("manufacturer_vehicle_to_vehicle")
  vehiclesWithoutPlates VehicleWithoutPlate[] @relation("manufacturer_vehicle_to_vehicle_without_plate", map: "vehicles_without_plate")

  @@map("manufacturer_vehicles")
}

model InsuranceCompany {
  id String @id @default(uuid(7)) @db.Uuid

  name  String
  icon  String
  image String?

  cnpj String @db.VarChar(14)

  quotes Quote[] @relation("insurance_company_to_quote")
  safes  Safe[]  @relation("insurance_company_to_safe")

  contacts InsuranceCompanyCategoryContact[] @relation("insurance_company_to_insurance_company_category_contact")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([cnpj])
  @@map("insurance_companies")
}

model InsuranceCompanyCategoryContact {
  id String @id @default(uuid(7)) @db.Uuid

  index Int

  label String

  insuranceCompanyId String           @map("insurance_company_id") @db.Uuid
  insuranceCompany   InsuranceCompany @relation("insurance_company_to_insurance_company_category_contact", fields: [insuranceCompanyId], references: [id], onDelete: Cascade, map: "insurance_company")

  contacts InsuranceCompanyContact[] @relation("insurance_company_category_contact_to_insurance_company_contact", map: "insurance_company_contacts")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([insuranceCompanyId, index])
  @@map("insurance_companies_categories_contacts")
}

model InsuranceCompanyContact {
  id String @id @default(uuid(7)) @db.Uuid

  index Int

  coverage InsuranceCompanyContactCoverage

  value      String   @db.VarChar(13)
  isWhatsapp Boolean? @map("is_whatsapp")

  categoryId String                          @map("category_id") @db.Uuid
  category   InsuranceCompanyCategoryContact @relation("insurance_company_category_contact_to_insurance_company_contact", fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([categoryId, value])
  @@unique([categoryId, index])
  @@map("insurance_companies_contacts")
}

enum Role {
  owner
  admin
  customer
  broker
  producer
  finance
  counter
}

enum ModalityInsurance {
  car
}

enum StatusQuote {
  waiting
  quoting
  quoted
  sent
  recused
  confirmed
}

enum MaritalStatus {
  single
  married
  divorced
  widowed
  separated
  common_law_marriage
}

enum VehicleUsage {
  leisure_and_work
  leisure
  client_supplier_visits
  app_based_transport
  taxi
  public_transportation
  delivieries
  tourism
}

enum VehicleExchange {
  manual
  automatic
}

enum Residence {
  home
  apartment
  house_condominium
  others
}

enum Garage {
  automatic_gate
  manual_gate
  private
  no_garage
}

enum GarageWork {
  yes
  no
  does_not_work
  does_not_use
}

enum GarageSchool {
  yes
  no
  does_not_study
  does_not_use
}

enum InsuranceCompanyContactCoverage {
  all_regions
  capitals_and_metropolitan_regions
}
