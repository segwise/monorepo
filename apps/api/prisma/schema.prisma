generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  runtime                = "bun"
  importFileExtension    = "ts"
  generatedFileExtension = "ts"
  moduleFormat           = "esm"
  previewFeatures        = ["relationJoins", "nativeDistinct", "fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid(7)) @db.Uuid

  name  String
  image String?

  email         String
  emailVerified Boolean? @map("email_verified")

  cpf  String? @db.VarChar(11)
  cnpj String? @db.VarChar(14)

  phone String? @db.VarChar(13)

  role Role

  banned     Boolean?
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires") @db.Date

  sessions             Session[] @relation("session_to_user")
  sessionsImpersonated Session[] @relation("session_to_user_impersonated", map: "sessions_impersonated")

  accounts Account[] @relation("account_to_user")

  members     Member[]     @relation("member_to_user")
  invitations Invitation[] @relation("invitation_to_user")

  quotes Quote[] @relation("producer_quotes")
  safes  Safe[]  @relation("producer_safes")

  paymentPayerAndReceivers PaymentPayerAndReceiver[] @relation("payment_payer_and_receiver_to_user", map: "payment_payer_and_receivers")

  pix String?

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([email])
  @@unique([cpf])
  @@unique([cnpj])
  @@index([name])
  @@index([email])
  @@index([phone])
  @@map("users")
}

model Session {
  id String @id @default(uuid(7)) @db.Uuid

  token String

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  userId String @map("user_id") @db.Uuid
  user   User   @relation("session_to_user", fields: [userId], references: [id], onDelete: Cascade)

  activeBrokerId String? @map("active_broker_id") @db.Uuid
  activeBroker   Broker? @relation("broker_to_session", fields: [activeBrokerId], references: [id], map: "active_broker", onDelete: Cascade)

  impersonatedBy String? @map("impersonated_by") @db.Uuid
  impersonated   User?   @relation("session_to_user_impersonated", fields: [impersonatedBy], references: [id], onDelete: Cascade)

  expiresAt DateTime @map("expires_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([token])
  @@index([userId])
  @@index([activeBrokerId])
  @@index([impersonatedBy])
  @@map("sessions")
}

model Account {
  id String @id @default(uuid(7)) @db.Uuid

  scope    String?
  password String?

  issuer String

  idToken      String? @map("id_token")
  accessToken  String? @map("access_token")
  refreshToken String? @map("refresh_token")

  accountId  String @map("account_id")
  providerId String @map("provider_id")

  userId String @map("user_id") @db.Uuid
  user   User   @relation("account_to_user", fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique(id)
  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id String @id @default(uuid(7)) @db.Uuid

  identifier String
  value      String

  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("verifications")
}

model TemporaryInsured {
  id String @id @default(uuid(7)) @db.Uuid

  name  String
  phone String @db.VarChar(13)

  cpf               String?        @db.VarChar(11)
  cnpj              String?        @db.VarChar(14)
  birth             DateTime?      @db.Date
  age               Int?           @db.SmallInt
  maritalStatus     MaritalStatus? @map("marital_status")
  qualificationTime Int?           @map("qualification_time") @db.SmallInt
  profession        String?

  brokerId String @map("broker_id") @db.Uuid
  broker   Broker @relation("broker_to_temporary_insured", fields: [brokerId], references: [id], onDelete: Cascade)

  quotes Quote[] @relation("quote_to_temporary_insured")
  safes  Safe[]  @relation("safe_to_temporary_insured")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([brokerId, cpf])
  @@unique([brokerId, cnpj])
  @@index([name])
  @@index([phone])
  @@index([cpf])
  @@index([cnpj])
  @@map("temporary_insureds")
}

model Insured {
  id String @id @default(uuid(7)) @db.Uuid

  name  String
  phone String @db.VarChar(13)

  cpf           String?        @db.VarChar(11)
  cnpj          String?        @db.VarChar(14)
  birth         DateTime?      @db.Date
  age           Int?           @db.SmallInt
  maritalStatus MaritalStatus? @map("marital_status")
  profession    String?

  qualificationTime Int? @map("qualification_time") @db.SmallInt

  brokerId String @map("broker_id") @db.Uuid
  broker   Broker @relation("broker_to_insured", fields: [brokerId], references: [id], onDelete: Cascade)

  quotes Quote[] @relation("insured_to_quote")
  safes  Safe[]  @relation("insured_to_safe")

  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  marketplaceVehicles MarketplaceVehicle[]

  @@unique([brokerId, cpf])
  @@unique([brokerId, cnpj])
  @@index([name])
  @@index([phone])
  @@index([cpf])
  @@index([cnpj])
  @@map("insureds")
}

model Quote {
  id String @id @default(uuid(7)) @db.Uuid

  temporaryInsuredId String?           @map("temporary_insured_id") @db.Uuid
  temporaryInsured   TemporaryInsured? @relation("quote_to_temporary_insured", fields: [temporaryInsuredId], references: [id], onDelete: Restrict, map: "temporary_insured")

  insuredId String?  @map("insured_id") @db.Uuid
  insured   Insured? @relation("insured_to_quote", fields: [insuredId], references: [id], onDelete: Restrict)

  modality ModalityInsurance

  renewal     Boolean?
  association Boolean?

  insuranceCompanyId String?           @map("insurance_company_id") @db.Uuid
  insuranceCompany   InsuranceCompany? @relation("insurance_company_to_quote", fields: [insuranceCompanyId], references: [id], onDelete: Restrict, map: "insurance_company")

  brokerId String @map("broker_id") @db.Uuid
  broker   Broker @relation("broker_to_quote", fields: [brokerId], references: [id], onDelete: Cascade)

  expiration DateTime? @db.Date
  franchise  Decimal?  @db.Decimal(10, 2)

  quoteVehicle QuoteVehicle? @relation("quote_to_quote_vehicle", map: "quote_vehicle")

  producerId String? @map("producer_id") @db.Uuid
  producer   User?   @relation("producer_quotes", fields: [producerId], references: [id], onDelete: Restrict)

  status        StatusQuote @default(waiting)
  statusAt      DateTime    @default(now()) @map("status_at") @db.Timestamptz
  statusMessage String?     @map("status_message")

  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([requestedAt])
  @@index([producerId])
  @@index([insuranceCompanyId])
  @@index([status])
  @@index([modality])
  @@index([id, requestedAt])
  @@map("quotes")
}

model Safe {
  id String @id @default(uuid(7)) @db.Uuid

  isExternal Boolean? @map("is_external")

  externalId String? @db.Uuid

  proposalCode String? @map("proposal_code")
  policyCode   String? @map("policy_code")

  producerId String? @map("producer_id") @db.Uuid
  producer   User?   @relation("producer_safes", fields: [producerId], references: [id], onDelete: Restrict)

  temporaryInsuredId String?           @map("temporary_insured_id") @db.Uuid
  temporaryInsured   TemporaryInsured? @relation("safe_to_temporary_insured", fields: [temporaryInsuredId], references: [id], onDelete: Restrict, map: "temporary_insured")

  insuredId String?  @map("insured_id") @db.Uuid
  insured   Insured? @relation("insured_to_safe", fields: [insuredId], references: [id], onDelete: Restrict)

  modality ModalityInsurance

  renewal Boolean?

  previousSafeId String? @map("previous_safe_id") @db.Uuid
  previousSafe   Safe?   @relation("related_policies", fields: [previousSafeId], references: [id], map: "previous_safe")

  successorSafe Safe? @relation("related_policies", map: "successor_safe")

  insuranceCompanyId String?           @map("insurance_company_id") @db.Uuid
  insuranceCompany   InsuranceCompany? @relation("insurance_company_to_safe", fields: [insuranceCompanyId], references: [id], onDelete: Restrict, map: "insurance_company")

  brokerId String @map("broker_id") @db.Uuid
  broker   Broker @relation("broker_to_safe", fields: [brokerId], references: [id], onDelete: Cascade)

  safeVehicle SafeVehicle? @relation("safe_to_safe_vehicle", map: "safe_vehicle")

  installments     Int?     @db.SmallInt
  award            Decimal? @db.Decimal(10, 2)
  franchise        Decimal? @db.Decimal(10, 2)
  commission       Decimal? @db.Decimal(10, 2)
  commissionAmount Decimal? @map("commission_amount") @db.Decimal(10, 2)

  commissionOfType              TypeOfCommission? @map("commission_of_type")
  commissionPercentage          Int?              @map("commission_percentage") @db.SmallInt
  commissionDiscountPercentage  Int?              @map("commission_discount_percentage") @db.SmallInt
  commissionDiscountFixed       Decimal?          @map("commission_discount_fixed") @db.Decimal(10, 2)
  commissionInstallments        Int?              @map("commission_installments") @db.SmallInt
  commissionAmountProducer      Decimal?          @map("commission_amount_producer") @db.Decimal(10, 2)
  commissionMonthlyInterest     Int?              @map("commission_monthly_interest") @db.SmallInt
  commissionPayInterestStarting Int?              @map("commission_pay_interest_starting") @db.SmallInt
  commissionTypeOfInterest      TypeOfInterest?   @map("commission_type_of_interest")
  commissionPaymentDate         DateTime?         @map("commission_payment_date") @db.Timestamptz

  commissionGross Decimal? @map("commission_gross") @db.Decimal(10, 2)
  commissionNet   Decimal? @map("commission_net") @db.Decimal(10, 2)

  status        StatusSafe @default(active)
  statusAt      DateTime   @default(now()) @map("status_at") @db.Timestamptz
  statusMessage String?    @map("status_message")

  requestedAt  DateTime  @map("requested_at") @db.Timestamptz
  effectivedAt DateTime? @map("effectived_at") @db.Date
  expiration   DateTime  @db.Date

  endorsements Endorsement[] @relation("endorsement_to_safe")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([externalId])
  @@unique([previousSafeId])
  @@map("safes")
}

model QuoteVehicle {
  id String @id @default(uuid(7)) @db.Uuid

  quoteId String @map("quote_id") @db.Uuid
  quote   Quote  @relation("quote_to_quote_vehicle", fields: [quoteId], references: [id], onDelete: Cascade)

  plate String? @db.VarChar(7)

  vehicleId String?  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle? @relation("quote_vehicle_to_vehicle", fields: [vehicleId], references: [id], onDelete: Restrict)

  vehicleWithoutPlateId String?              @map("vehicle_without_plate_id") @db.Uuid
  vehicleWithoutPlate   VehicleWithoutPlate? @relation("quote_vehicle_to_vehicle_without_plate", fields: [vehicleWithoutPlateId], references: [id], map: "vehicle_without_plate", onDelete: Restrict)

  usage VehicleUsage

  overnightPostalCode String @map("overnight_postal_code") @db.VarChar(8)

  residesIn            Residence? @map("resides_in")
  garageOfTheResidence Garage?    @map("garage_of_the_residence")

  garageAtWork   GarageWork?   @map("garage_at_work")
  garageAtSchool GarageSchool? @map("garage_at_school")

  armored              Boolean?
  gasKit               Boolean? @map("gas_kit")
  theInsuredIsTheOwner Boolean? @map("the_insured_is_the_owner")
  funded               Boolean?
  driversUnder26       Boolean? @map("drivers_under_26")

  driverCPF   String?   @map("driver_cpf") @db.VarChar(11)
  driverName  String?   @map("driver_name")
  driverBirth DateTime? @map("driver_birth") @db.Date
  driverAge   Int?      @map("driver_age") @db.SmallInt
  driverPhone String?   @map("driver_phone") @db.VarChar(13)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([vehicleWithoutPlateId])
  @@unique([quoteId])
  @@map("quote_vehicles")
}

model SafeVehicle {
  id String @id @default(uuid(7)) @db.Uuid

  safeId String @map("safe_id") @db.Uuid
  safe   Safe   @relation("safe_to_safe_vehicle", fields: [safeId], references: [id], onDelete: Cascade)

  plate String? @db.VarChar(7)

  vehicleId String?  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle? @relation("safe_vehicle_to_vehicle", fields: [vehicleId], references: [id], onDelete: Restrict)

  vehicleWithoutPlateId String?              @map("vehicle_without_plate_id") @db.Uuid
  vehicleWithoutPlate   VehicleWithoutPlate? @relation("safe_vehicle_to_vehicle_without_plate", fields: [vehicleWithoutPlateId], references: [id], map: "vehicle_without_plate", onDelete: Restrict)

  usage VehicleUsage

  overnightPostalCode String @map("overnight_postal_code") @db.VarChar(8)

  driverCPF   String?   @map("driver_cpf") @db.VarChar(11)
  driverName  String?   @map("driver_name")
  driverBirth DateTime? @map("driver_birth") @db.Date
  driverAge   Int?      @map("driver_age") @db.SmallInt
  driverPhone String?   @map("driver_phone") @db.VarChar(13)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([vehicleWithoutPlateId])
  @@unique([safeId])
  @@map("safe_vehicles")
}

model Vehicle {
  id String @id @default(uuid(7)) @db.Uuid

  plate            String @db.VarChar(7)
  plateAlternative String @map("plate_alternative") @db.VarChar(7)

  manufacturerId String              @map("manufacturer_id") @db.Uuid
  manufacturer   ManufacturerVehicle @relation("manufacturer_vehicle_to_vehicle", fields: [manufacturerId], references: [id], onDelete: Restrict)

  model     String
  modelYear Int    @map("model_year") @db.SmallInt

  exchange VehicleExchange?

  chassi String?

  image String?

  quoteVehicles QuoteVehicle[] @relation("quote_vehicle_to_vehicle", map: "quote_vehicles")
  safeVehicles  SafeVehicle[]  @relation("safe_vehicle_to_vehicle", map: "safe_vehicles")

  endorsements Endorsement[] @relation("endorsement_to_vehicle")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([plate])
  @@unique([plateAlternative])
  @@unique([plate, plateAlternative])
  @@map("vehicles")
}

model VehicleWithoutPlate {
  id String @id @default(uuid(7)) @db.Uuid

  manufacturerId String?              @map("manufacturer_id") @db.Uuid
  manufacturer   ManufacturerVehicle? @relation("manufacturer_vehicle_to_vehicle_without_plate", fields: [manufacturerId], references: [id], onDelete: Restrict)

  model     String?
  modelYear Int?    @map("model_year") @db.SmallInt

  exchange VehicleExchange?

  quoteVehicles QuoteVehicle[] @relation("quote_vehicle_to_vehicle_without_plate", map: "quote_vehicles")
  safeVehicles  SafeVehicle[]  @relation("safe_vehicle_to_vehicle_without_plate", map: "safe_vehicles")

  endorsements Endorsement[] @relation("endorsement_to_vehicle")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("vehicles_without_plate")
}

model ManufacturerVehicle {
  id String @id @default(uuid(7)) @db.Uuid

  name  String
  icon  String?
  image String?

  slugs String[]

  vehicles              Vehicle[]             @relation("manufacturer_vehicle_to_vehicle")
  vehiclesWithoutPlates VehicleWithoutPlate[] @relation("manufacturer_vehicle_to_vehicle_without_plate", map: "vehicles_without_plate")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("manufacturer_vehicles")
}

model InsuranceCompany {
  id String @id @default(uuid(7)) @db.Uuid

  name    String
  fantasy String?
  icon    String
  image   String?

  cnpj String @db.VarChar(14)

  quotes Quote[] @relation("insurance_company_to_quote")
  safes  Safe[]  @relation("insurance_company_to_safe")

  contacts InsuranceCompanyCategoryContact[] @relation("insurance_company_to_insurance_company_category_contact")

  paymentPayerAndReceivers PaymentPayerAndReceiver[] @relation("insurance_company_to_payment_payer_and_receiver", map: "payment_payer_and_receivers")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("insurance_companies")
}

model InsuranceCompanyCategoryContact {
  id String @id @default(uuid(7)) @db.Uuid

  index Int @db.SmallInt

  label String

  insuranceCompanyId String           @map("insurance_company_id") @db.Uuid
  insuranceCompany   InsuranceCompany @relation("insurance_company_to_insurance_company_category_contact", fields: [insuranceCompanyId], references: [id], onDelete: Cascade, map: "insurance_company")

  contacts InsuranceCompanyContact[] @relation("insurance_company_category_contact_to_insurance_company_contact", map: "insurance_company_contacts")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([insuranceCompanyId, index])
  @@map("insurance_companies_categories_contacts")
}

model InsuranceCompanyContact {
  id String @id @default(uuid(7)) @db.Uuid

  index Int @db.SmallInt

  coverage InsuranceCompanyContactCoverage

  value      String   @db.VarChar(13)
  isWhatsapp Boolean? @map("is_whatsapp")

  categoryId String                          @map("category_id") @db.Uuid
  category   InsuranceCompanyCategoryContact @relation("insurance_company_category_contact_to_insurance_company_contact", fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([categoryId, value, isWhatsapp])
  @@unique([categoryId, index])
  @@map("insurance_companies_contacts")
}

model Broker {
  id String @id @default(uuid(7)) @db.Uuid

  name    String
  fantasy String?

  cnpj String @db.VarChar(14)

  slug String

  logo  String?
  image String?

  metadata Json? @db.JsonB

  sessions Session[] @relation("broker_to_session")

  members     Member[]     @relation("broker_to_member")
  invitations Invitation[] @relation("broker_to_invitation")

  temporaryInsureds TemporaryInsured[] @relation("broker_to_temporary_insured", map: "temporary_insureds")
  insureds          Insured[]          @relation("broker_to_insured")

  safes  Safe[]  @relation("broker_to_safe")
  quotes Quote[] @relation("broker_to_quote")

  paymentPayerAndReceivers PaymentPayerAndReceiver[] @relation("broker_to_payment_payer_and_receiver")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([cnpj])
  @@unique([slug])
  @@map("brokers")
}

model Member {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation("member_to_user", fields: [userId], references: [id], onDelete: Cascade)

  brokerId String @map("broker_id") @db.Uuid
  broker   Broker @relation("broker_to_member", fields: [brokerId], references: [id], onDelete: Cascade)

  role Role

  referral String?

  typeOfProduction         TypeOfProduction?        @map("type_of_production")
  percentageOfProduction   Int?                     @map("percentage_of_production") @db.SmallInt
  typeOfProductionPayment  TypeOfProductionPayment? @map("type_of_production_payment")
  startOfProductionPayment Int?                     @map("start_of_production_payment") @db.SmallInt

  invitationMessage String? @map("invitation_message") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([referral])
  @@unique([brokerId, userId])
  @@index([referral])
  @@index([brokerId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id String @id @default(uuid(7)) @db.Uuid

  brokerId String? @map("broker_id") @db.Uuid
  broker   Broker? @relation("broker_to_invitation", fields: [brokerId], references: [id], onDelete: Cascade)

  email String

  role Role

  referral String?

  typeOfProduction         TypeOfProduction?        @map("type_of_production")
  percentageOfProduction   Int?                     @map("percentage_of_production") @db.SmallInt
  typeOfProductionPayment  TypeOfProductionPayment? @map("type_of_production_payment")
  startOfProductionPayment Int?                     @map("start_of_production_payment") @db.SmallInt

  invitationMessage String? @map("invitation_message") @db.Text

  status StatusInvitation @default(pending)

  inviterId String @map("inviter_id") @db.Uuid
  inviter   User   @relation("invitation_to_user", fields: [inviterId], references: [id], onDelete: Cascade)

  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([brokerId, email])
  @@unique([referral])
  @@index([brokerId])
  @@index([email])
  @@map("invitation")
}

model PaymentPayerAndReceiver {
  id String @id @db.Uuid

  brokerId String? @map("broker_id") @db.Uuid
  broker   Broker? @relation("broker_to_payment_payer_and_receiver", fields: [brokerId], references: [id], onDelete: Cascade)

  insuranceCompanyId String?           @map("insurance_company_id") @db.Uuid
  insuranceCompany   InsuranceCompany? @relation("insurance_company_to_payment_payer_and_receiver", fields: [insuranceCompanyId], references: [id], onDelete: Cascade, map: "insurance_company")

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation("payment_payer_and_receiver_to_user", fields: [userId], references: [id], onDelete: Cascade)

  paymentsPayer    Payment[] @relation("payment_to_payment_payer")
  paymentsReceiver Payment[] @relation("payment_to_payment_receiver")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([id])
  @@map("payment_payers")
}

model Payment {
  id String @id @default(uuid(7)) @db.Uuid

  receiverId String?                  @map("receiver_id") @db.Uuid
  receiver   PaymentPayerAndReceiver? @relation("payment_to_payment_receiver", fields: [receiverId], references: [id], onDelete: Restrict)

  payerId String?                  @map("payer_id") @db.Uuid
  payer   PaymentPayerAndReceiver? @relation("payment_to_payment_payer", fields: [payerId], references: [id], onDelete: Restrict)

  method MethodPayment

  amount     Decimal  @db.Decimal(10, 2)
  amountPaid Decimal? @map("amount_paid") @db.Decimal(10, 2)

  description String?

  installment Int? @db.SmallInt

  installments Payment[] @relation("related_installments")

  relatedPaymentId String?  @map("related_payment_id") @db.Uuid
  relatedPayment   Payment? @relation("related_installments", fields: [relatedPaymentId], references: [id], onDelete: Cascade, map: "related_payment")

  status StatusPayment

  expiration DateTime  @db.Timestamptz
  paidAt     DateTime? @map("paid_at") @db.Timestamptz

  metadata Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("payments")
}

model QuoteFinancingAVehicle {
  id String @id @default(uuid(7)) @db.Uuid

  referral String?

  model String
  year  Int    @db.SmallInt

  amount      Decimal  @db.Decimal(10, 2)
  downPayment Decimal? @db.Decimal(10, 2)

  name  String
  phone String @db.VarChar(13)

  @@index([referral])
  @@index([name])
  @@index([phone])
  @@map("quotes_financing_a_vehicles")
}

model MarketplaceVehicle {
  id String @id @default(uuid(7)) @db.Uuid

  // Relação com o segurado
  insuredId String  @map("insured_id") @db.Uuid
  insured   Insured @relation(fields: [insuredId], references: [id])

  photos String[]

  type           MarketplaceVehicleType
  manufacturer   String
  model          String
  year           Int                              @db.SmallInt
  modelYear      Int                              @map("model_year") @db.SmallInt
  plate          String                           @db.VarChar(7)
  color          String
  fuel           MarketplaceVehicleFuel
  transmission   MarketplaceVehicleTransmission
  direction      MarketplaceVehicleDirection
  financialState MarketplaceVehicleFinancialState @map("financial_state")

  price   Decimal @db.Decimal(10, 2)
  mileage Int

  optionals     MarketplaceVehicleFeature[]
  conservations MarketplaceVehicleConservation[]

  description String?
  phone       String  @db.VarChar(13)

  postalCode String @map("postal_code") @db.VarChar(8)
  state      String
  city       String

  acceptExchange        Boolean?                                @map("accept_exchange")
  acceptExchangeAmount  MarketplaceVehicleAcceptExchangeAmount? @map("accept_exchange_amount")
  acceptExchangeChange1 String?                                 @map("accept_exchange_change_1")
  acceptExchangeChange2 String?                                 @map("accept_exchange_change_2")
  acceptExchangeChange3 String?                                 @map("accept_exchange_change_3")

  status MarketplaceVehicleStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([plate])
  @@index([insuredId])
  @@index([status])
  @@index([type])
  @@index([state, city])
  @@index([price])
  @@index([fuel])
  @@index([transmission])
  @@map("marketplace_vehicles")
}

model Endorsement {
  id String @id @default(uuid(7)) @db.Uuid

  type EndorsementType

  safeId String @map("safe_id") @db.Uuid
  safe   Safe   @relation("endorsement_to_safe", fields: [safeId], references: [id], onDelete: Cascade)

  driverCPF   String?   @map("driver_cpf") @db.VarChar(11)
  driverName  String?   @map("driver_name")
  driverBirth DateTime? @map("driver_birth") @db.Date
  driverAge   Int?      @map("driver_age") @db.SmallInt

  vehicleId String?  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle? @relation("endorsement_to_vehicle", fields: [vehicleId], references: [id], onDelete: Restrict)

  vehicleWithoutPlateId String?              @map("vehicle_without_plate_id") @db.Uuid
  vehicleWithoutPlate   VehicleWithoutPlate? @relation("endorsement_to_vehicle", fields: [vehicleWithoutPlateId], references: [id], map: "vehicle_without_plate", onDelete: Restrict)

  effectivedAt DateTime? @map("effectived_at") @db.Date

  franchise  Decimal? @db.Decimal(10, 2)
  amount     Decimal? @db.Decimal(10, 2)
  percentage Int?     @db.SmallInt
  commission Decimal? @db.Decimal(10, 2)

  overnightPostalCode String? @map("overnight_postal_code") @db.VarChar(8)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("endorsements")
}

