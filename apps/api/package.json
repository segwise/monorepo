{
	"name": "backend",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --bun run --watch src/index.ts",
		"build": "bun --bun build src/index.ts --outdir=dist --production --minify --sourcemap=inline --target=bun && bun --bun build prisma.config.ts --production --minify --sourcemap=inline --target=bun",
		"start": "bun --bun run index.js",
		"auth:generate": "bun x --bun @better-auth/cli generate --config src/services/auth/index.ts",
		"auth:migrate": "bun x --bun @better-auth/cli migrate --config src/services/auth/index.ts",
		"db:generate": "bun x --bun prisma generate",
		"db:migrate": "bun x --bun prisma migrate dev",
		"db:reset": "bun x --bun prisma migrate reset",
		"db:deploy": "bun x --bun prisma migrate deploy",
		"db:seed": "bun run --bun ./seed.js",
		"deploy": "git add . && git commit -m 'commit automatic' && git push && clear"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.7",
		"@types/bun": "latest",
		"prisma": "7.0.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.0.1",
		"@prisma/client": "7.0.1",
		"better-auth": "^1.4.1",
		"hono": "^4.10.6",
		"resend": "^6.5.2",
		"zod": "^4.1.13"
	}
}
