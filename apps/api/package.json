{
	"name": "@segwise/api",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --bun run --watch src/index.ts",
		"start": "bun --bun run src/index.ts",
		"auth:generate": "bun x --bun @better-auth/cli generate --config src/services/auth/index.ts",
		"auth:migrate": "bun x --bun @better-auth/cli migrate --config src/services/auth/index.ts",
		"lint": "bun --bun biome check",
		"typecheck": "bun --bun tsc --noEmit",
		"pdf:styles": "bun run scripts/build-pdf-styles.ts"
	},
	"devDependencies": {
		"@react-email/ui": "^6.9.2",
		"@types/bun": "latest",
		"@types/react": "catalog:web",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@bull-board/api": "^9.10.2",
		"@bull-board/hono": "^9.10.2",
		"@hono/zod-validator": "^0.7.6",
		"@prisma/adapter-pg": "^7.10.0",
		"@segwise/core": "workspace:*",
		"@segwise/database": "workspace:*",
		"better-auth": "^1.7.1",
		"bullmq": "^6.3.10",
		"date-fns": "^4.4.0",
		"date-fns-tz": "^3.2.0",
		"handlebars": "^4.7.9",
		"hono": "^4.13.4",
		"ioredis": "^5.11.1",
		"openai": "^7.9.0",
		"pdf-lib": "^1.17.1",
		"pdf-parse": "^2.4.5",
		"quick-lru": "^7.3.0",
		"react": "catalog:web",
		"react-dom": "catalog:web",
		"react-email": "^6.9.3",
		"resend": "^6.22.1",
		"ua-parser-js": "^2.0.10",
		"xior": "^0.8.4",
		"zod": "^4.4.3"
	}
}
