{
	"name": "backend",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --bun run --watch src/index.ts",
		"build": "bun --bun build src/index.ts --outdir=dist --production --minify --sourcemap=inline --target=bun --packages=external && bun --bun build src/seed.ts --outdir=dist --production --minify --sourcemap=inline --target=bun --packages=external",
		"start": "bun --bun run index.js",
		"auth:generate": "bun x --bun @better-auth/cli generate --config src/services/auth/index.ts",
		"auth:migrate": "bun x --bun @better-auth/cli migrate --config src/services/auth/index.ts",
		"db:generate": "bun x --bun prisma generate",
		"db:migrate:dev": "bun x --bun prisma migrate dev",
		"db:migrate:reset": "bun x --bun prisma migrate reset",
		"db:deploy": "bun x --bun prisma migrate deploy",
		"db:seed": "bun --bun prisma db seed",
		"deploy": "git add . && git commit -m 'commit automatic' && git push && clear"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.7",
		"@types/bun": "latest",
		"prisma": "7.0.1"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@faker-js/faker": "^10.4.0",
		"@hono/zod-validator": "^0.7.6",
		"@prisma/adapter-pg": "^7.5.0",
		"@prisma/client": "7.0.1",
		"@segwise/core": "^1.1.150",
		"better-auth": "^1.5.6",
		"date-fns": "^4.1.0",
		"handlebars": "^4.7.9",
		"hono": "^4.12.9",
		"pdf-lib": "^1.17.1",
		"playwright": "^1.58.2",
		"quick-lru": "^7.3.0",
		"resend": "^6.9.4",
		"xior": "^0.8.3",
		"zod": "^4.3.6"
	}
}
