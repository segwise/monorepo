{
	"name": "@segwise/database",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./client": "./generated/prisma/client.ts",
		"./enums": "./generated/prisma/enums.ts",
		"./models": "./generated/prisma/models.ts",
		"./internal/prismaNamespace": "./generated/prisma/internal/prismaNamespace.ts"
	},
	"scripts": {
		"generate": "DATABASE_URL=${DATABASE_URL:-postgresql://generate:generate@localhost:5432/generate} bun x --bun prisma generate",
		"migrate:dev": "bun x --bun prisma migrate dev",
		"migrate:local": "bun scripts/db-local.ts migrate dev",
		"status:local": "bun scripts/db-local.ts migrate status",
		"local": "bun scripts/db-local.ts",
		"migrate:reset": "bun x --bun prisma migrate reset",
		"deploy": "bun x --bun prisma migrate deploy",
		"seed": "bun --bun prisma db seed",
		"lint": "biome check"
	},
	"dependencies": {
		"@prisma/client": "^7.10.0",
		"dotenv": "^17.4.2",
		"prisma": "^7.10.0"
	},
	"devDependencies": {
		"@types/bun": "latest"
	}
}
