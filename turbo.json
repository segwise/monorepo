{
	"$schema": "https://turbo.build/schema.json",
	"ui": "stream",
	"globalEnv": ["NODE_ENV"],
	"tasks": {
		"generate": {
			"inputs": ["prisma/schema.prisma", "prisma.config.ts"],
			"outputs": ["generated/**"],
			"env": ["DATABASE_URL"]
		},
		"build": {
			"dependsOn": ["^build", "generate"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"],
			"env": ["NEXT_PUBLIC_*"]
		},
		"typecheck": {
			"dependsOn": ["^build", "generate"]
		},
		"lint": {},
		"dev": {
			"dependsOn": ["^build", "generate"],
			"cache": false,
			"persistent": true
		}
	}
}
