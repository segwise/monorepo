# Variáveis do compose de produção (deploy/docker-compose.yml).
# No Dokploy: Compose → aba Environment (nunca commitar valores reais).

# --- Compartilhadas pelos 3 backoffices ---
NEXT_PUBLIC_API_URL=
BETTER_AUTH_SECRET=

# --- api ---
APPLICATION_URL=
# Opcional: só se o portal da corretora ficar em outro endereço que APPLICATION_URL
# CUSTOMER_PORTAL_URL=
BASE_URL=
AUTH_SECRET=
# Postgres e Redis da fila ficam FORA do compose, como Databases do Dokploy (backup e ciclo de
# vida independentes do deploy). Use o "Internal Host"/porta e a senha que o Dokploy mostra em
# cada Database, ex.: postgresql://usuario:senha@<appName-do-postgres>:5432/banco e
# redis://default:senha@<appName-do-redis>:6379 (a api já está na rede dokploy-network).
DATABASE_URL=
# Redis da fila do BullMQ: precisa de AOF (--appendonly yes) e maxmemory-policy noeviction.
QUEUE_URL=

AI_BASE_URL=
AI_MODEL=
# Opcionais (o compose tem default):
# AI_MODEL_VISION=
# AI_REQUEST_TIMEOUT_MS=
# AI_MAX_TEXT_CHARS=
# AI_MAX_COMPLETION_TOKENS=
AI_API_KEY=

# Token entre a api e o serviço de PDF (gere com: openssl rand -hex 32). Obrigatório.
PDF_TOKEN=troque-por-openssl-rand-hex-32
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

APIPLACAS_TOKEN=
CPFCNPJ_TOKEN=
PLACA_FIPE_TOKEN=
AMOUNT_SEARCH_VEHICLE_COMPLETE=

TRANSFEERA_CLIENT_SECRET=
TRANSFEERA_CLIENT_SECRET_USER=
TRANSFEERA_PAYMENT_PIX_KEY=
TRANSFEERA_PAYMENT_SPLIT_PIX_TYPE=
TRANSFEERA_PAYMENT_SPLIT_PIX=

IOS_APP_URL=
ANDROID_APP_URL=
IOS_XCAR_APP_URL=
ANDROID_XCAR_APP_URL=
